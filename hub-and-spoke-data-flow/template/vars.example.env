# ==============================================================================
# Variáveis do pipeline — preencha e salve como vars.env com os valores
# reais. Cada CHAVE=valor aqui vira __CHAVE_EM_MINUSCULO__ nos arquivos
# resolvidos em runtime (ex.: REGION=southamerica-east1 substitui __region__).
#
# Não versione o arquivo preenchido se ele tiver dado sensível — o
# vars.example.env é só o modelo/exemplo.
# ==============================================================================

DATASET_ID=served

# --- Região ---
REGION=southamerica-east1

# --- Projetos (spokes) ---
TRAIN_PROJECT_ID=prj-meuproduto-mdl-prd
SERVING_PROJECT_ID=prj-meuproduto-inf-prd
HUB_PROJECT_ID=prj-hub-poc

# --- Buckets de pipeline root ---
TRAIN_PIPELINE_ROOT=gs://bucket-data-meuproduto-mdl/pipeline_root
SERVING_PIPELINE_ROOT=gs://bucket-data-meuproduto-inf/pipeline_root

# --- Service Accounts ---
TRAIN_SERVICE_ACCOUNT=sa-vertex-ai-pipeline@prj-meuproduto-mdl-prd.iam.gserviceaccount.com
SERVING_SERVICE_ACCOUNT=sa-vertex-ai-pipeline@prj-meuproduto-inf-prd.iam.gserviceaccount.com

# --- Artifact Registry (índice PyPI privado) ---
ARTIFACT_REGISTRY_INDEX_URL=https://southamerica-east1-python.pkg.dev/prj-artifact-services-prd/acr-artifact-prd-001/simple/

# --- Cloud Workflow de promoção ---
WORKFLOW_NAME=meuproduto-model-promotion-workflow

# --- Dataform ---
# git_commitish (a branch do repo Dataform a compilar) não vem daqui — é
# hardcoded em .cloudbuild/dev.yaml ('modelagem') e .cloudbuild/prod.yaml
# ('main'), mesmo padrão usado pras branches do próprio deploy.yml.
DATAFORM_REPOSITORY_ID=df-repo-meuproduto
DATAFORM_SA_PREFIX=sa-df-meuproduto

# --- Analytics Hub ---
DATA_EXCHANGE_ID=exchange_meuproduto
LISTING_ID=listing_meuproduto

# --- GitHub Actions / Cloud Build ---
# As branches que disparam cada job (modelagem/main) são hardcoded direto em
# .github/workflows/deploy.yml — não vêm daqui.
WORKERPOOL_DEV=workerpool-meuproduto-mdl
WORKERPOOL_PROD=workerpool-meuproduto-inf

# Identidade com que o Cloud Build roda os steps do build (--service-account
# do `gcloud builds submit`) — diferente de TRAIN_SERVICE_ACCOUNT/
# SERVING_SERVICE_ACCOUNT acima, que é só a SA usada pra submeter o pipeline
# ao Vertex AI. Formato exigido pelo gcloud: caminho completo do recurso, não
# só o e-mail. NPRD = ambiente de modelagem/dev (MDL), PRD = inferência (INF).
CLOUDBUILD_SERVICE_ACCOUNT_NPRD=projects/prj-meuproduto-mdl-prd/serviceAccounts/sa-cloudbuild-mdl@prj-meuproduto-mdl-prd.iam.gserviceaccount.com
CLOUDBUILD_SERVICE_ACCOUNT_PRD=projects/prj-meuproduto-inf-prd/serviceAccounts/sa-cloudbuild-inf@prj-meuproduto-inf-prd.iam.gserviceaccount.com
