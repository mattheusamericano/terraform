# ==============================================================================
# Variáveis do template — preencha e salve como vars.env (ou outro nome) antes
# de rodar ./generate.sh. Cada CHAVE=valor aqui vira __chave_em_minusculo__
# no template (ex.: REGION=southamerica-east1 substitui __region__).
#
# Não versione o arquivo preenchido se ele tiver dado sensível — o
# vars.example.env é só o modelo/exemplo.
# ==============================================================================

# --- Identificação do produto/modelo ---
PRODUCT=meuproduto
DOMAIN=rsk
ENDPOINT_NAME=endpoint-meuproduto-risk
MODEL_ID=meuproduto_risk_xgb_v1
PIPELINE_NAME=meuproduto-risk-xgb-pipeline
DATASET_ID=served
MODELS_DATASET=models

# --- Região ---
REGION=southamerica-east1

# --- Projetos (spokes) ---
TRAIN_PROJECT_ID=prj-meuproduto-mdl-prd
SERVING_PROJECT_ID=prj-meuproduto-inf-prd
HUB_PROJECT_ID=prj-hub-poc

# --- Buckets de pipeline root ---
TRAIN_PIPELINE_ROOT=gs://bucket-data-meuproduto-mdl/pipeline_root
TRAIN_MODELS_EXPORT_URI=gs://bucket-data-meuproduto-mdl/models/meuproduto_risk_xgb_v1

# --- Service Accounts ---
TRAIN_SERVICE_ACCOUNT=sa-vertex-ai-pipeline@prj-meuproduto-mdl-prd.iam.gserviceaccount.com
SERVING_SERVICE_ACCOUNT=sa-vertex-ai-pipeline@prj-meuproduto-inf-prd.iam.gserviceaccount.com

# --- Artifact Registry (índice PyPI privado) ---
ARTIFACT_REGISTRY_INDEX_URL=https://southamerica-east1-python.pkg.dev/prj-artifact-services-prd/acr-artifact-prd-001/simple/

# --- Cloud Workflow de promoção ---
WORKFLOW_NAME=meuproduto-model-promotion-workflow

# --- Dataform ---
DATAFORM_REPOSITORY_ID=df-repo-meuproduto
DATAFORM_GIT_COMMITISH=main
DATAFORM_SA_PREFIX=sa-df-meuproduto

# --- Analytics Hub ---
DATA_EXCHANGE_ID=exchange_meuproduto
LISTING_ID=listing_meuproduto

# --- GitHub Actions / Cloud Build ---
BRANCH_NAME=meuproduto-model
WORKERPOOL_DEV=workerpool-meuproduto-mdl
WORKERPOOL_PROD=workerpool-meuproduto-inf

# ==============================================================================
# Reservadas para o disparo do pipeline de treino/inferência a partir do Cloud
# Workflow — NÃO ESTAMOS UTILIZANDO NO MOMENTO. model-config.yaml ainda exige
# um valor aqui (preencha para o generate.sh não deixar placeholder órfão),
# mas nenhum step do workflow nem do prod.yaml lê esse valor hoje — ver
# README.md, seção "O que este template NÃO conecta ainda".
# ==============================================================================
SERVING_PIPELINE_ROOT=gs://bucket-data-meuproduto-inf/pipeline_root
SERVING_TEMPLATE_URI=gs://bucket-data-meuproduto-inf/pipeline_root/pipeline.json
SERVING_BUCKET_NAME=bucket-data-meuproduto-inf
